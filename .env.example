# ---------------------------------------------------------------------------
# Database (Neon Postgres)
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# ---------------------------------------------------------------------------
# Auth (Clerk) — this app uses its OWN Clerk application.
# Add the optional "Continue with MemoryNest" OIDC connection in the Clerk
# dashboard, then flip the flag below to surface the button.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
CLERK_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"

# Set to "memorynest" (the OIDC connection's strategy id) to show the
# "Continue with MemoryNest" button. Leave empty for vanilla OSS self-hosting.
NEXT_PUBLIC_MEMORYNEST_OIDC_STRATEGY=""

# ---------------------------------------------------------------------------
# Media storage (Cloudflare R2 — S3 compatible).
# A future "bring your own storage" mode reuses the same S3 variables.
# ---------------------------------------------------------------------------
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="family-tree-media"
# Public base URL for serving objects (e.g. https://media.example.com or the
# bucket's *.r2.dev URL).
R2_PUBLIC_BASE_URL=""
